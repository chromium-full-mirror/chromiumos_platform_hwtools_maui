#!/bin/bash
# Copyright 2026 The ChromiumOS Authors
# Use of this source code is governed by a BSD-style license that can be
# found in the LICENSE file.

# Wrapper to run maui-flash inside the maui-utils Docker container.
# Handles file path translation by copying files to a temp directory.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANAGER="${SCRIPT_DIR}/maui_image_manager.py"

# Separate arguments for manager vs tool
MANAGER_ARGS=()
TOOL_ARGS=()
VERSION_MODE=0
JSON_MODE=0

while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
        --version)
            VERSION_MODE=1
            shift
            ;;
        --utils_channel)
            MANAGER_ARGS+=("--utils_channel" "$2")
            shift 2
            ;;
        --utils_channel=*)
            MANAGER_ARGS+=("$1")
            shift
            ;;
        --fw_channel)
            TOOL_ARGS+=("--fw_channel" "$2")
            shift 2
            ;;
        --fw_channel=*)
            TOOL_ARGS+=("$1")
            shift
            ;;
        --json)
            JSON_MODE=1
            TOOL_ARGS+=("$1")
            shift
            ;;
        --verbose)
            MANAGER_ARGS+=("$1") # Pass verbose to manager
            TOOL_ARGS+=("$1")   # Also pass verbose to the tool if it supports it
            shift
            ;;
        *)
            TOOL_ARGS+=("$1")
            shift
            ;;
    esac
done

# Get Image Tag
if ! IMAGE_TAG=$(python3 "$MANAGER" "${MANAGER_ARGS[@]}"); then
    exit 1
fi

if [ "$VERSION_MODE" -eq 1 ]; then
    # Run version check inside the container
    docker run --rm "$IMAGE_TAG" maui-flash --internal-version
    exit 0
fi

# Create a temporary directory on the host
HOST_TMP_DIR=$(mktemp -d -t maui-flash-XXXXXX)
# Ensure cleanup on exit
trap 'rm -rf "$HOST_TMP_DIR"' EXIT

CONTAINER_MOUNT_POINT="/mnt/firmware_dir"
CMD_ARGS=()
FILE_ARG_NEXT=0
READ_ARG_NEXT=0
# Host path for an output file written by the tool (h2h --read).
OUT_HOST_PATH=""

map_output_file() {
    OUT_HOST_PATH="$1"
    CMD_ARGS+=("$CONTAINER_MOUNT_POINT/$(basename "$1")")
}

# Iterate through parsed tool arguments to find file paths
for arg in "${TOOL_ARGS[@]}"; do
    if [ "$READ_ARG_NEXT" -eq 1 ]; then
        map_output_file "$arg"
        READ_ARG_NEXT=0
    elif [ "$FILE_ARG_NEXT" -eq 1 ]; then
        # This argument is the file path for --file (space separated)
        if [ -f "$arg" ]; then
            FILE_NAME="$(basename "$arg")"
            cp "$arg" "$HOST_TMP_DIR/$FILE_NAME"
            CMD_ARGS+=("$CONTAINER_MOUNT_POINT/$FILE_NAME")
        else
            # Let the tool report it (h2h-serial --json prints a JSON error).
            echo "Warning: File not found: $arg" >&2
            CMD_ARGS+=("$arg")
        fi
        FILE_ARG_NEXT=0
    elif [[ "$arg" == "--file="* ]]; then
        # This argument is --file=/path/to/file (equals separated)
        FILE_PATH="${arg#--file=}"
        if [ -f "$FILE_PATH" ]; then
            FILE_NAME="$(basename "$FILE_PATH")"
            cp "$FILE_PATH" "$HOST_TMP_DIR/$FILE_NAME"
            CMD_ARGS+=("--file" "$CONTAINER_MOUNT_POINT/$FILE_NAME")
        else
            echo "Warning: File not found: $FILE_PATH" >&2
            CMD_ARGS+=("--file" "$FILE_PATH")
        fi
    elif [ "$arg" == "--file" ]; then
        CMD_ARGS+=("$arg")
        FILE_ARG_NEXT=1
    elif [[ "$arg" == "--read="* ]]; then
        CMD_ARGS+=("--read")
        map_output_file "${arg#--read=}"
    elif [ "$arg" == "--read" ]; then
        CMD_ARGS+=("$arg")
        READ_ARG_NEXT=1
    else
        CMD_ARGS+=("$arg")
    fi
done

# Run maui-flash inside the container. Only allocate a TTY when run from a
# terminal and not with --json: a TTY merges stderr into stdout (which breaks
# --json consumers) and `docker run -t` fails when stdin is not a terminal.
DOCKER_TTY_ARGS=(-i)
if [ "$JSON_MODE" -eq 0 ] && [ -t 0 ] && [ -t 1 ] && [ -t 2 ]; then
    DOCKER_TTY_ARGS=(-it)
fi
docker run --rm "${DOCKER_TTY_ARGS[@]}" \
    --privileged \
    -v /dev:/dev \
    -v "$HOST_TMP_DIR:$CONTAINER_MOUNT_POINT" \
    "${IMAGE_TAG}" \
    maui-flash "${CMD_ARGS[@]}"

# Copy an output file back to the requested host path
if [ -n "$OUT_HOST_PATH" ]; then
    cp "$HOST_TMP_DIR/$(basename "$OUT_HOST_PATH")" "$OUT_HOST_PATH"
    echo "Saved $OUT_HOST_PATH" >&2
fi
