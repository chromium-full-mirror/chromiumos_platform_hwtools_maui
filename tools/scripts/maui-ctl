# Wrapper to run maui-ctl inside the maui-utils Docker container.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANAGER="${SCRIPT_DIR}/maui_image_manager.py"

# Separate arguments for manager vs tool
MANAGER_ARGS=()
TOOL_ARGS=()

while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
        --channel)
            MANAGER_ARGS+=("$1" "$2")
            shift 2
            ;;
        --channel=*)
            MANAGER_ARGS+=("$1")
            shift
            ;;
        --verbose)
            MANAGER_ARGS+=("$1") # Pass verbose to manager
            # TOOL_ARGS+=("$1")   # Also pass verbose to the tool if it supports it
            shift
            ;;
        *)
            TOOL_ARGS+=("$1")
            shift
            ;;
    esac
done

# Get Image Tag
IMAGE_TAG=$(python3 "$MANAGER" "${MANAGER_ARGS[@]}")
if [ $? -ne 0 ]; then
    exit 1
fi

# Run maui-ctl inside the container
docker run --rm -it \
    --privileged \
    -v /dev:/dev \
    "$IMAGE_TAG" \
    maui-ctl "${TOOL_ARGS[@]}"
