#!/bin/bash

# This wrapper script automates the execution of the `fw-updater` tool within a Docker container.
# It performs the following steps:
#
# 1.  Verifies if the `maui-utils` Docker image exists locally.
#     If not found, it automatically builds the image using `dockerfiles/Dockerfile.utils`.
# 2.  Iterates through all command-line arguments passed to the script.
#     If an argument is identified as an existing file (a firmware image path),
#     it resolves its absolute path on the host system.
#     The directory containing this file is then prepared to be mounted into the Docker container
#     at a fixed location (`/mnt/firmware_dir`), and the argument is translated to reflect this
#     internal container path.
#     Other arguments (like flags or non-file paths) are passed through as-is.
# 3.  Executes the `maui-utils` Docker container with the following settings:
#     *   `--rm`: Automatically removes the container upon exit.
#     *   `-it`: Runs the container in interactive mode and allocates a pseudo-TTY, allowing user interaction.
#     *   `--privileged`: Grants extended privileges to the container, necessary for direct hardware access (e.g., USB devices).
#     *   `-v /dev:/dev`: Mounts the host's `/dev` directory into the container, providing access to serial ports and other device files.
#     *   `-v <host_path>:/mnt/firmware_dir`: Mounts the directory of the detected firmware file(s) from the host
#         into `/mnt/firmware_dir` inside the container, making the firmware accessible to `fw-updater`.
# 4.  Runs the `fw-updater` command inside the container with the (potentially translated) arguments.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(git -C "${SCRIPT_DIR}" rev-parse --show-toplevel)"
DOCKERFILE="${PROJECT_ROOT}/dockerfiles/Dockerfile.utils"
IMAGE_NAME="maui-utils"

# Check if the Docker image exists
if [[ "$(docker images -q "${IMAGE_NAME}" 2> /dev/null)" == "" ]]; then
    echo "Image '${IMAGE_NAME}' not found. Building..."
    if [ -f "${DOCKERFILE}" ]; then
        docker build -t "${IMAGE_NAME}" -f "${DOCKERFILE}" "${PROJECT_ROOT}"
    else
        echo "Error: Dockerfile not found at ${DOCKERFILE}"
        exit 1
    fi
fi

CMD_ARGS=()
MOUNT_ARGS=()
# We use a fixed mount point inside the container for the file's directory
CONTAINER_MOUNT_POINT="/mnt/firmware_dir"
MOUNTED_HOST_DIR=""

for arg in "$@"; do
    # Check if argument is a regular file
    if [ -f "$arg" ]; then
        # We only support automatically mounting one directory context.
        if [ -z "$MOUNTED_HOST_DIR" ]; then
            HOST_FILE_PATH="$(realpath "$arg")"
            HOST_DIR_PATH="$(dirname "$HOST_FILE_PATH")"
            FILE_NAME="$(basename "$HOST_FILE_PATH")"

            MOUNTED_HOST_DIR="$HOST_DIR_PATH"
            MOUNT_ARGS+=("-v" "${HOST_DIR_PATH}:${CONTAINER_MOUNT_POINT}")
            CMD_ARGS+=("${CONTAINER_MOUNT_POINT}/${FILE_NAME}")
        else
            CMD_ARGS+=("$arg")
        fi
    else
        CMD_ARGS+=("$arg")
    fi
done

# Run fw-updater inside the container
# --privileged and -v /dev:/dev are required for hardware access (USB)
docker run --rm -it \
    --privileged \
    -v /dev:/dev \
    "${MOUNT_ARGS[@]}" \
    "${IMAGE_NAME}" \
    fw-updater "${CMD_ARGS[@]}"
