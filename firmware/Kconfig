config PDC_DEBUG
	bool "Enable debug messages from PDC"
	depends on UART_INTERRUPT_DRIVEN

config TPS6699X_INTERRUPTS
	bool "Enable TPS6699X interrupt handling"
	default n

choice SBU_MUX_TYPE
	bool "Type of mux for SBU lanes"

config SBU_MUX_TYPE_PDC
	bool "PDC as SBU lanes mux"

config SBU_MUX_TYPE_GPIO
	bool "GPIO as SBU lanes mux"

endchoice

config SBU_MUX_INIT_DELAY
	int "Delay between bootup and polling in milliseconds"
	default 300

config SBU_MUX_PERIOD
	int "Period of reading the SBU lanes in milliseconds"
	default 100

config HOST_MUX_INIT_DELAY
	int "Delay between bootup and polling in milliseconds"
	default 10

config HOST_MUX_PERIOD
	int "Period of reading the Host CC lanes in milliseconds"
	default 20

config HOST_MUX_HIGH_THRESH
	int "Lower voltage threshold to treat signal as high (millivolts)"
	default 200

config HOST_MUX_SEL_INVERTED
	bool "USB3 host mux SEL polarity is inverted"
	default y if BOARD_MAUI_V1P2_IT82002
	help
	  By default USB3_MUX_HOST_SEL is driven low for CC1 (normal) and high
	  for CC2 (flipped) orientation. Enable this on boards where the mux
	  is wired the other way round, so CC1 drives SEL high and CC2 drives
	  it low. maui_v1p2_it82002 needs this (verified on hardware).

config MAUI_HOST_MUX
	bool "Automatic USB host mux / hub control"
	default y
	help
	  Polls the Host CC lanes and drives HUB_RESET_L and the USB3 host mux
	  select/output-enable lines accordingly.

	  On maui_v1p2_it82002 the EC's own USB device reaches the host through
	  that hub, so a mis-detected CC state also takes down the console and
	  the firmware-update path. Recovery then needs the RO/RW bootloaders,
	  which do not run this module.

config MAUI_H2H_FLASH
	bool "H2H bridge (PL27A1) SPI flash access"
	default y if BOARD_MAUI_V1P2_IT82002
	depends on SPI
	help
	  Lets the MCU take over the PL27A1 H2H bridge's SPI flash (holding the
	  bridge in reset and switching the flash mux) and adds the h2h_flash
	  shell commands. Only boards with the EC-side SPI bus and flash mux
	  wired up support this.

config GPIO_INIT_PRIORITY
	int "GPIO subsystem init priority"
	default 89

config MAUI_HEALTH
	bool "Boot health monitoring, crashloop counter and ETWD reset"
	default y if SOC_IT82002AW
	help
	  Boot-target selection and the crashloop counter in BBRAM, the ETWD
	  hardware reset used by 'reboot'/'reset', and the 'health' shell
	  command group.

	  Only maui_v1p2_it82002 has the BBRAM and the 3-stage bootloader chain
	  this depends on; the MSPM0 boards fall back to sys_reboot().

config MAUI_NVS_STORAGE
	bool "NVS-backed persistent storage (serial number, boot target)"
	default y if SOC_IT82002AW
	depends on NVS
	help
	  Backs the 'serial get'/'serial set' shell commands and the USB serial
	  number reported by all three boot stages.

	  Requires a 'storage_partition' node, which only maui_v1p2_it82002
	  defines.

config MAUI_HEALTH_FLASH_DIAGNOSTICS
	bool "Enable destructive flash-protection diagnostics in the health shell"
	depends on MAUI_HEALTH && SOC_IT82002AW
	default y
	help
	  Adds 'health test_flash_protect', 'health lock_eplr' and
	  'health probe_eplr'.

	  These are bring-up tools that manipulate hardware write protection
	  directly. test_flash_protect deliberately erases and rewrites
	  bootloader sectors to prove the hardware blocks it; if protection is
	  ever not armed, that attack succeeds and destroys both bootloaders,
	  leaving the board recoverable only with an external programmer. It
	  does check the EWPR registers and abort first, but that check is only
	  as good as our understanding of the silicon.

	  Turn this off for production images. 'health status' stays available
	  and reports the same protection state non-destructively.

menuconfig MAUI_RPC
	bool "Machine-to-machine RPC over a second USB CDC-ACM interface"
	select NANOPB
	select COBS
	select RING_BUFFER
	help
	  Exposes a second CDC-ACM interface ("Maui RPC") that carries
	  COBS-framed Nanopb messages defined in proto/maui_rpc.proto, for
	  host automation and maui-flash (go/maui-ite-design). Needs a
	  'cdc_acm_uart1' devicetree node, the nanopb west module,
	  USB_DEVICE_STACK_NEXT and UART_INTERRUPT_DRIVEN.

if MAUI_RPC

config MAUI_RPC_RX_BUF_SIZE
	int "RX ring buffer size"
	default 16384
	help
	  Bytes buffered between the USB callback and the RPC thread. Large
	  enough for several maximum-size frames so the host can pipeline
	  requests while a handler (e.g. a flash write) is running.

config MAUI_RPC_TX_BUF_SIZE
	int "TX ring buffer size"
	default 2048

config MAUI_RPC_TX_TIMEOUT_MS
	int "Give up sending after the host stops reading for this long (ms)"
	default 1000

config MAUI_RPC_STACK_SIZE
	int "RPC thread stack size"
	default 3072

config MAUI_RPC_THREAD_PRIORITY
	int "RPC thread priority"
	default 10

module = MAUI_RPC
module-str = maui_rpc
source "subsys/logging/Kconfig.template.log_config"

endif # MAUI_RPC

source "Kconfig.zephyr"
