/dts-v1/;

#include <ti/mspm0/g/mspm0g3507.dtsi>
#include <ti/mspm0/g/mspm0g1x0x_g3x0x-pinctrl.dtsi>

#include <zephyr/dt-bindings/clock/mspm0_clock.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include "adc.dtsi"

/ {
	model = "Maui Proto v1";
	compatible = "ti,mspm0g3507";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	leds: leds {
		compatible = "gpio-leds";

		ec_led_green: ec_led_green {
			gpios = <&gpioa 12 GPIO_ACTIVE_HIGH>;
		};
		ec_led_amber: ec_led_amber {
			gpios = <&gpioa 13 GPIO_ACTIVE_HIGH>;
		};
	};

	outputs {
		compatible = "gpio-leds";

		hub_smbus_en_ss_susp: hub_smbus_en_ss_susp_l {
			gpios = <&gpioa 29 GPIO_ACTIVE_LOW>;
		};
		pdc_hi_priority_irq: pdc_hi_priority_irq_l {
			gpios = <&gpioa 30 GPIO_ACTIVE_LOW>;
		};
		h2h_reset: h2h_reset_l {
			gpios = <&gpioa 31 GPIO_ACTIVE_LOW>;
		};
		usb3_mux_dut_oe: usb3_mux_dut_oe_r_l {
			gpios = <&gpiob 8 GPIO_ACTIVE_LOW>;
		};
		usb3_mux_dut_sel: usb3_mux_dut_sel_r {
			gpios = <&gpiob 9 GPIO_ACTIVE_HIGH>;
		};
		usb2_mux_dut_oe: usb2_mux_dut_oe_r_l {
			gpios = <&gpiob 10 GPIO_ACTIVE_LOW>;
		};
		usb2_mux_dut_sel: usb2_mux_dut_sel_r {
			gpios = <&gpiob 11 GPIO_ACTIVE_HIGH>;
		};
		pp5000_cutoff: pp5000_cutoff {
			gpios = <&gpiob 12 GPIO_ACTIVE_HIGH>;
		};
		usb3_mux_host_oe: usb3_mux_host_oe_r_l {
			gpios = <&gpiob 21 GPIO_ACTIVE_LOW>;
		};
		usb3_mux_host_sel: usb3_mux_host_sel_r {
			gpios = <&gpiob 22 GPIO_ACTIVE_HIGH>;
		};
		hub_reset: hub_reset_l {
			gpios = <&gpiob 26 GPIO_ACTIVE_LOW>;
		};
	};

	inputs {
		//TODO: rethink the GPIOs definitions/driver
		compatible = "gpio-keys";
		debounce-interval-ms = <0>;

		h2h_host_access_led: h2h_host_access_led {
			gpios = <&gpioa 7 GPIO_ACTIVE_HIGH>;
		};
		h2h_dut_access_led: h2h_dut_access_led {
			gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;
		};
		pdc_debug_uart_tx: pdc_debug_uart_tx {
			gpios = <&gpioa 9 GPIO_ACTIVE_HIGH>;
		};
		hub_ss_up_status: hub_ss_up_status {
			gpios = <&gpioa 24 GPIO_ACTIVE_HIGH>;
		};
		hub_hs_up_status: hub_hs_up_status {
			gpios = <&gpioa 25 GPIO_ACTIVE_HIGH>;
		};
		i2c_pdc_irq: i2c_pdc_irq_l {
			gpios = <&gpioa 28 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};
		h2h_dut_host_access_led: h2h_dut_host_access_led {
			gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;
		};
		pp1200_pg_od: pp1200_pg_od_l {
			gpios = <&gpiob 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};
		pp3300_pg_od: pp3300_pg_od_l {
			gpios = <&gpiob 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};
		pp1100_pg_od: pp1100_pg_od_l {
			gpios = <&gpiob 23 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};
		hub_hs_suspend: hub_hs_suspend {
			gpios = <&gpiob 25 GPIO_ACTIVE_HIGH>;
		};
	};

	hwrev {
		compatible = "google,maui-hwrev";
		gpios = <&gpioa 23 GPIO_ACTIVE_HIGH>,
				<&gpioa 4 GPIO_ACTIVE_HIGH>,
				<&gpioa 3 GPIO_ACTIVE_HIGH>;
	};

	dut_sbu_mux: dut-sbu-mux {
		compatible = "google,maui-sbu-mux";
		status = "okay";

		pdc = <&pdc>;
		mux-oe-gpios = <&gpiob 6 GPIO_ACTIVE_LOW>;
		mux-sel-gpios = <&gpiob 7 GPIO_ACTIVE_HIGH>;
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(80)>;
};

&ulpclk {
	clock-frequency = <DT_FREQ_M(40)>;
	clk-div = <2>;
};

&mclk {
	clock-frequency = <DT_FREQ_M(80)>;
	clocks = <&hsclk 0>;
};

&hsclk {
	clocks = <&syspll2x 0>;
	status = "okay";
};

&syspll2x {
	status = "okay";
};

&flash0 {
	status = "okay";
};

&pinctrl {
	status = "okay";
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&i2c0 {
	pinctrl-0 = <&i2c0_scl_pa1 &i2c0_sda_pa0>;
	pinctrl-names = "default";
	status = "okay";

	pdc: tps6699x@20 {
		compatible = "ti,tps6699x";
		reg = <0x20>;
	};
};

&uart0 {
	status = "okay";

	// UART0_EC_TX_FTDI_RX	BSLTX (BSL UART_TX)	PA10
	// UART0_FTDI_TX_EC_RX	BSLRX (BSL UART_RX)	PA11
	current-speed = <115200>;
	pinctrl-0 = <&uart0_tx_pa10 &uart0_rx_pa11>;
	pinctrl-names = "default";
};

&uart1 {
	status = "okay";
	current-speed = <12000000>;
	pinctrl-0 = <&uart1_rx_pa9>;
	pinctrl-names = "default";
};

&vref0 {
	status = "okay";
};
